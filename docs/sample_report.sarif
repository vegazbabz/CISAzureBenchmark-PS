          "version": "2.0.0",
          "semanticVersion": "2.0.0",
          "rules": [
            {
              "id": "2.1.1",
              "name": "CIS2_1_1",
              "shortDescription": {
                "text": "Ensure that Azure Databricks is deployed in a customer-managed virtual network (VNet)"
              },
              "help": {
                "text": "Databricks > Workspace > Settings"
              },
              "properties": {
                "section": "2 - Azure Databricks",
                "cisLevel": 1
              }
            },
            {
              "id": "2.1.3",
              "name": "CIS2_1_3",
              "shortDescription": {
                "text": "Ensure that Traffic is Encrypted Between Cluster Worker Nodes"
              },
              "help": {
                "text": "Databricks > Workspace > Settings"
              },
              "properties": {
                "section": "2 - Azure Databricks",
                "cisLevel": 2
              }
            },
            {
              "id": "2.1.6",
              "name": "CIS2_1_6",
              "shortDescription": {
                "text": "Ensure that Usage is Restricted and Expiry is Enforced for Databricks Personal Access Tokens"
              },
              "help": {
                "text": "Databricks > Workspace > Settings"
              },
              "properties": {
                "section": "2 - Azure Databricks",
                "cisLevel": 1
              }
            },
            {
              "id": "2.1.10",
              "name": "CIS2_1_10",
              "shortDescription": {
                "text": "Ensure 'Allow Public Network Access' is set to 'Disabled'"
